# GitHub Configuration (Required)
GITHUB_TOKEN=ghp_xxx
GITHUB_OWNER=your-username

# Project Configuration (Optional)
BASE_BRANCH=main
MAX_REVIEW_ITERATIONS=5
PHASE2_LOOP_MAX_ATTEMPTS=100
ECOSYSTEM_STATE_PATH=.ecosystem/state.json
ECOSYSTEM_WORKSPACE=.ecosystem/worktrees
REPO_CONTEXT_MAX_FILES=80
REPO_CONTEXT_MAX_CHARS=40000
REPO_CONTEXT_FILE_MAX_CHARS=4000
ISSUE_SELECT_LIMIT=30
LOG_LEVEL=info

# LLM Routing (Optional)
# Implementation and planning agents use Claude Haiku by default, then Codex only when Claude usage is maxed/limited.
PLANNING_LLM_PROVIDER=claude
IMPLEMENTATION_LLM_PROVIDER=claude
IMPLEMENTATION_AGENTS=CodingAgent,FixAgent
IMPLEMENTATION_CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL=claude-haiku-4-5-20251001
RESUME_AGENT_SESSIONS=false
AGENT_COMMAND_TIMEOUT_MS=900000

# OpenAI-compatible local LLM endpoint, e.g. Ollama or LM Studio.
# Only used when PLANNING_LLM_PROVIDER or IMPLEMENTATION_LLM_PROVIDER is set to local.
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen2.5-coder:7b
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_TEMPERATURE=0.2

# Gemini Integration (Optional)
# Used when PLANNING_LLM_PROVIDER / IMPLEMENTATION_LLM_PROVIDER / FALLBACK_LLM_PROVIDER is gemini.
# GEMINI_API_KEY=
# GEMINI_MODEL applies to both planning and implementation unless overridden below.
# GEMINI_MODEL=gemini-2.5-flash
# PLANNING_GEMINI_MODEL=gemini-2.5-flash
# IMPLEMENTATION_GEMINI_MODEL=gemini-2.5-flash

# Codex Integration (Optional)
CODEX_REVIEW_ENABLED=false
# Codex is used for Claude usage-limit fallback and for PR review.
# CODEX_BIN=C:\Users\your-user\.vscode\extensions\openai.chatgpt-...\bin\windows-x86_64\codex.exe
# CODEX_MODEL=
# CODEX_INTELLIGENCE accepts low, medium, high, or xhigh. Leave unset to use Codex CLI config.
# CODEX_INTELLIGENCE=high
CODEX_SANDBOX=read-only
