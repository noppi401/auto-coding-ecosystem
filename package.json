{
  "name": "auto-coding-ecosystem",
  "version": "1.0.0",
  "description": "Multi-agent automated coding pipeline powered by Claude",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ace": "dist/index.js"
  },
  "files": [
    "dist",
    "prompts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:window": "start \"\" \"%LOCALAPPDATA%\\Microsoft\\WindowsApps\\wt.exe\" -d . cmd /k \"npm run dev\"",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "claude",
    "agent",
    "automation",
    "coding",
    "github"
  ],
  "author": "noppi401",
  "license": "Apache-2.0",
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "dotenv": "^16.4.5",
    "ink": "^8.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.10",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.8",
    "happy-dom": "^20.10.1",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.8"
  }
}
